        }
      },
      "muna": {
        "name": "muna",
        "workspace": "/home/ugoji-harry/.openclaw/workspace/muna",
        "agentDir": "/home/ugoji-harry/.openclaw/agents/muna/agent",
        "identity": {
          "name": "muna"
        },
        "model": "ollama/qwen3:4b",
        "thinkingDefault": "low"
      }
