      },
      "researcher": {
        "name": "researcher",
        "workspace": "/home/ugoji-harry/.openclaw/workspace/researcher",
        "agentDir": "/home/ugoji-harry/.openclaw/agents/researcher/agent",
        "identity": {
          "name": "Researcher",
          "emoji": "\ud83d\udd0e",
          "theme": "curious, evidence-led research"
        },
        "subagents": {
          "allowAgents": []
        }
      },
      "writer": {
        "name": "writer",
        "workspace": "/home/ugoji-harry/.openclaw/workspace/writer",
        "agentDir": "/home/ugoji-harry/.openclaw/agents/writer/agent",
        "identity": {
          "name": "Writer",
          "emoji": "\u270d\ufe0f",
          "theme": "clear, audience-aware writing"
        },
        "subagents": {
          "allowAgents": []
        }
      },
      "reviewer": {
        "name": "reviewer",
        "workspace": "/home/ugoji-harry/.openclaw/workspace/reviewer",
