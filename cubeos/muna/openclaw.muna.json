        "ollama/qwen3:8b": {}
      },
      "model": {
        "primary": "ollama/qwen3:4b",
        "fallbacks": []
      },
      "systemAgent": {
        "agentId": "muna"
      },
      "heartbeat": {
        "agentId": "coordinator"
      },
      "workspace": "/home/ugoji-harry/.openclaw/workspace"
    },
    "ownership": "explicit",
    "entries": {
      "coordinator": {
        "name": "coordinator",
        "workspace": "/home/ugoji-harry/.openclaw/workspace/coordinator",
        "agentDir": "/home/ugoji-harry/.openclaw/agents/coordinator/agent",
        "identity": {
          "name": "Chief of Staff",
          "emoji": "\ud83e\udded",
          "theme": "calm, accountable coordination"
        },
        "subagents": {
          "allowAgents": [
            "researcher",
            "writer",
            "reviewer"
          ],
          "delegationMode": "prefer"
