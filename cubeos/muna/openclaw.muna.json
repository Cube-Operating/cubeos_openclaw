  },
  "models": {
    "providers": {
      "ollama": {
        "baseUrl": "http://127.0.0.1:11434",
        "apiKey": "ollama-local",
        "api": "ollama",
        "timeoutSeconds": 300,
        "models": [
          {
            "id": "llama3.1:8b",
            "name": "llama3.1:8b",
            "reasoning": false,
            "input": [
              "text"
            ],
            "contextTokens": 8192,
            "maxTokens": 1024,
            "params": {
              "num_ctx": 8192,
              "keep_alive": "30m"
            }
          },
          {
            "id": "qwen3:8b",
            "name": "qwen3:8b",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextTokens": 6144,
            "maxTokens": 1536,
            "params": {
              "num_ctx": 6144,
              "keep_alive": "30m",
              "thinking": false
            }
          },
          {
            "id": "qwen3:4b",
            "name": "qwen3:4b",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextTokens": 8192,
            "maxTokens": 1536,
            "params": {
              "num_ctx": 8192,
              "keep_alive": "30m"
            }
          }
        ]
      }
    }
  },
  "tools": {
    "profile": "minimal",
    "alsoAllow": [
      "nodes"
    ],
    "deny": [
      "group:runtime",
      "group:fs",
      "group:web",
      "group:ui",
      "group:automation",
      "computer",
      "message",
      "presence",
      "ask_user",
      "tts"
    ],
    "toolSearch": false
  },
  "talk": {
    "agentId": "muna",
    "realtime": {
      "mode": "stt-tts"
    }
  },
  "tts": {
    "provider": "tts-local-cli",
    "providers": {
      "tts-local-cli": {
        "command": "/home/ugoji-harry/.local/piper/say.sh",
        "args": [
          "{{OutputPath}}",
          "{{Text}}"
        ],
        "outputFormat": "wav",
        "timeoutMs": 30000
      }
    }
  },
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "tailscale": {
      "mode": "off"
    }
  }
}
